# ignore image files
*.sif

# ignore object and shared object files
*.so
*.o

# ignore operating system files and temp files
.DS_Store
~*
*.swp

# Compiler-generated files
a.out
*.exe
*.mod
*.smod
*.sub
*.a
*.so
*.o
*.dylib
*.dll

# Ford-generated documentation folder
doc/html

# Python bytecode caches
__pycache__/

# Regenerable PDF grid caches (keyed to the .so hash; rebuild on demand)
*.npz

# fpm install output
bin/

# Slurm output and normgrid run artifacts (slurm/normgrid.sbatch writes these)
logs/
results/

# Generated from fpm.toml's version field by scripts/generate_version_include.py;
# run that script before building (every Dockerfile does) -- never commit the
# output, or it can silently go stale when fpm.toml's version is bumped.
src/version.f90.inc
