# HTCondor submit description for building a normalization table on the OSG.
# A TEMPLATE: adapt the container line and requirements to your access
# point / pool -- it has not been run against a live OSG pool.
#
#   python python/normgrid.py make-spec --band NR --nodes k=... --region 2 200 4 100 --epsrel 1e-7 --out spec_NR.json
#   python python/normgrid.py chunks spec_NR.json --size 100 \
#       | awk '{printf "spec_NR.json, %s, %s, NR_%s\n", $1, $2, $1}' > chunks_NR.txt
#   condor_submit osg/normgrid.sub          # (edit `queue` below to the right chunks file)
#   ... when done:
#   python python/normgrid.py merge --spec spec_NR.json --results 'result_NR_*.txt' --out norm_NR.h5
#
# Size chunks so a job takes ~10-30 minutes (OSG jobs can be evicted; an
# evicted chunk is simply re-run from the start).

universe                = vanilla
executable              = osg/normgrid_job.sh
arguments               = $(spec) $(start) $(stop) $(tag)
transfer_input_files    = $(spec)
transfer_output_files   = result_$(tag).txt
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# Container image built from Dockerfile_intel or _llvm (README: "Build the
# singularity/apptainer container"); replace with your staged image location.
+SingularityImage       = "osdf:///ospool/ap40/data/<user>/band.sif"
request_cpus            = 1
request_memory          = 1GB
request_disk            = 1GB
output                  = logs/$(tag).out
error                   = logs/$(tag).err
log                     = logs/normgrid.log
max_retries             = 2

queue spec, start, stop, tag from chunks_NR.txt
