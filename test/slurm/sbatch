#!/bin/bash
# Stand-in for `sbatch` in tests: runs the script (or every task of --array=A-B[%T])
# right here, one after another, and exits nonzero if any task does -- which is what
# `sbatch --wait` reports.  Only the options slurm/build_table.sh uses are understood.
set -u
ARRAY=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --array=*) ARRAY=${1#--array=}; shift ;;
        --*) shift ;;                 # --wait, --account=..., --partition=..., --time=..., --job-name=...
        *) break ;;
    esac
done
SCRIPT=$1; shift
LO=0 HI=0
if [[ -n "$ARRAY" ]]; then A=${ARRAY%%%*}; LO=${A%-*}; HI=${A#*-}; fi
rc=0
for ((i = LO; i <= HI; i++)); do
    if [[ -n "$ARRAY" ]]; then SLURM_ARRAY_TASK_ID=$i bash "$SCRIPT" "$@" >/dev/null || rc=1
    else bash "$SCRIPT" "$@" || rc=1; fi
done
echo "Submitted batch job 0 (mock; $SCRIPT array='${ARRAY}' rc=$rc)"
exit $rc
