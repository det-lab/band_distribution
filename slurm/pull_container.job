#!/bin/bash
# Pull the prebuilt band_distribution container from GHCR into a .sif.
#
#   sbatch slurm/pull_container.job [IMAGE] [DEST]
#
# Defaults to the LLVM build at commit 9d251ee (head of region_normalization,
# which is what python/cli/normgrid.py and PpqN_region/PpqG_region need).
#
# Nothing lands in $HOME: this cluster has no apptainer, only singularity-ce
# 3.8, whose layer cache and scratch space default to $HOME/.singularity
# (already 65 GB there).  SINGULARITY_CACHEDIR/TMPDIR are pointed at
# /scratch/$USER for the duration, and the .sif is written to /scratch too.
# The APPTAINER_* twins are set as well so this keeps working if the cluster
# moves to apptainer.
#
# squashfs-tools is installed on the login node but NOT on the compute nodes,
# so `singularity build` cannot find mksquashfs there and dies in under a
# second.  The binary is staged to /scratch/$USER/bin as mksquashfs.real (its
# libz/liblzma/liblzo2/liblz4 deps are all present on the compute nodes) and
# put on PATH below, behind a wrapper that pins its thread and memory use --
# see the comment on the wrapper for why that is necessary.
#
# The squash phase is gzip compression and scales with cores; the layer unpack
# before it is NFS-bound on many small files and does not.  At -n 1 the first
# run of this job split 87 min as ~35 unpack / ~46 squash, so the cores only
# help the second half.

#SBATCH -J band_pull
#SBATCH -p math-alderaan-short
#SBATCH --account=dark-matter-salting
#SBATCH -n 1
#SBATCH -c 16
#SBATCH --mem=32G
#SBATCH -t 02:00:00
#SBATCH -o logs/pull_container_%j.out
#SBATCH -e logs/pull_container_%j.err

set -euo pipefail

cd "$SLURM_SUBMIT_DIR" || exit 1

IMAGE=${1:-docker://ghcr.io/det-lab/band_distribution_llvm:v1.1.3}
DEST=${2:-/scratch/$USER/containers/band.sif}

SCRATCH=/scratch/$USER/singularity
mkdir -p "$SCRATCH/cache" "$SCRATCH/tmp" "$(dirname "$DEST")" "/scratch/$USER/bin"

BIN=/scratch/$USER/bin
if [[ ! -x "$BIN/mksquashfs.real" ]]; then
    if [[ -x /usr/sbin/mksquashfs ]]; then
        cp /usr/sbin/mksquashfs "$BIN/mksquashfs.real"
    else
        echo "mksquashfs is not staged and not on this node.  Run this once" >&2
        echo "on the login node, then resubmit:" >&2
        echo "  mkdir -p $BIN && cp /usr/sbin/mksquashfs $BIN/mksquashfs.real" >&2
        exit 1
    fi
fi

# singularity.conf sets `mksquashfs procs = 0` (auto-detect) and never passes
# -mem, and that file is root-owned -- so the only handle on either is the
# binary singularity picks up from PATH.  Both defaults are wrong inside a
# cgroup: mksquashfs auto-detects all 64 cores of the node rather than the 16
# this job is allocated, and sizes -mem from total node RAM (it reported
# 64368M) rather than from --mem.  The wrapper pins both.  Options go after
# source/dest in mksquashfs' syntax, hence "$@" first.
SQUASH_MEM=${SQUASH_MEM:-24G}
cat > "$BIN/mksquashfs" <<WRAP
#!/bin/bash
# generated by slurm/pull_container.job -- edit that, not this
exec "$BIN/mksquashfs.real" "\$@" -processors "\${SLURM_CPUS_PER_TASK:-1}" -mem $SQUASH_MEM
WRAP
chmod +x "$BIN/mksquashfs"
export PATH="$BIN:$PATH"

echo "mksquashfs  -processors ${SLURM_CPUS_PER_TASK:-1}  -mem $SQUASH_MEM"

export SINGULARITY_CACHEDIR="$SCRATCH/cache"
export SINGULARITY_TMPDIR="$SCRATCH/tmp"
export APPTAINER_CACHEDIR="$SCRATCH/cache"
export APPTAINER_TMPDIR="$SCRATCH/tmp"
export TMPDIR="$SCRATCH/tmp"

echo "host       $(hostname)"
echo "image      $IMAGE"
echo "dest       $DEST"
echo "cachedir   $SINGULARITY_CACHEDIR"
singularity --version

# --force so a re-run replaces a partial .sif from a killed job rather than
# stopping to ask.
time singularity build --force "$DEST" "$IMAGE"

echo
ls -lh "$DEST"

# Smoke test: the library must load and report its version, and normgrid must
# be importable inside the image.  A pull that "succeeds" into an image built
# from the wrong branch fails here rather than 4,500 array tasks later.
singularity exec "$DEST" /opt/anaconda/envs/band/bin/python -c "
import sys
sys.path.insert(0, '/app/python/internal')
sys.path.insert(0, '/app/python/cli')
import _ppqfort_bindings, normgrid
print('library version', '.'.join(map(str, _ppqfort_bindings.version())))
print('region entry points',
      hasattr(_ppqfort_bindings, 'ppqn_region'), hasattr(_ppqfort_bindings, 'ppqg_region'))
print('normgrid axes', normgrid.AXES)
"

echo
echo "done.  use it with:  BAND_SIF=$DEST ./slurm/submit_alderaan.sh"
