# Pinned to linux/amd64: this base image is multi-arch, but the
# environment.yaml installed below pulls the x86_64-only ifx_linux-64
# conda package.  On an arm64 host (e.g. Apple Silicon) an unpinned
# `docker build` would pull the arm64 base and then fail to resolve that
# package.
FROM --platform=linux/amd64 quay.io/jupyter/base-notebook

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
USER root

# Version of the repository to build: leave unset (default) to build from
# this local checkout, including any uncommitted changes; set to a tag or
# commit hash (--build-arg GIT_REF=v0.9.0) to instead clone and check out
# that exact revision from GitHub, ignoring the local checkout.
ARG GIT_REF=""

# fix-permissions at the end: under Rosetta emulation (Apple Silicon) the
# emulator writes $HOME/.cache/rosetta during this root-stage layer, and the
# image sets HOME=/home/jovyan globally, leaving .cache root-owned and
# breaking the later mamba install running as $NB_UID
RUN apt-get update && apt-get install -y \
    git \
    gcc \
    vim \
    libtree \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && fix-permissions "/home/${NB_USER}"

# Switch back to jovyan to avoid accidental container runs as root
USER $NB_UID

# Create the band conda environment from the same environment.yaml used by
# the other containers (ifx compiler, fpm, and all python packages), and
# register it as a notebook kernel so notebooks can select "Python (band)".
# Recipe: https://jupyter-docker-stacks.readthedocs.io/en/latest/using/recipes.html#add-a-custom-conda-environment-and-jupyter-kernel
COPY --chown=${NB_UID}:${NB_GID} environment.yaml /tmp/
RUN mamba env create -f /tmp/environment.yaml && \
    mamba run -n band python -m ipykernel install --user --name band --display-name "Python (band)" && \
    mamba clean --all -f -y && \
    fix-permissions "${CONDA_DIR}" && \
    fix-permissions "/home/${NB_USER}"

WORKDIR /home/${NB_USER}

# Stage the source: defaults to this local checkout; if GIT_REF is set,
# the RUN step below discards this and clones that revision instead.
COPY --chown=${NB_UID}:${NB_GID} src/ /tmp/band_src/src/
COPY --chown=${NB_UID}:${NB_GID} test/ /tmp/band_src/test/
COPY --chown=${NB_UID}:${NB_GID} fpm.toml /tmp/band_src/
COPY --chown=${NB_UID}:${NB_GID} python/ /tmp/band_src/python/

RUN if [ -n "$GIT_REF" ]; then \
        echo "Building band_distribution @ $GIT_REF (overriding local checkout)" && \
        rm -rf /tmp/band_src && \
        git clone https://github.com/det-lab/band_distribution.git /tmp/band_src && \
        cd /tmp/band_src && git checkout "$GIT_REF"; \
    else \
        echo "Building band_distribution from the local checkout"; \
    fi

RUN mkdir -p src test python \
    && cp -r /tmp/band_src/src/. src/ \
    && cp -r /tmp/band_src/test/. test/ \
    && cp -r /tmp/band_src/python/. python/ \
    && cp /tmp/band_src/fpm.toml . \
    && rm -rf /tmp/band_src

# Intel runtime libs (libimf.so, libiomp5.so, ...) live in the band env's
# lib dir; needed when python ctypes loads libband_distribution.so
ENV LD_LIBRARY_PATH=${CONDA_DIR}/envs/band/lib:/home/jovyan/lib

# Link the Intel OpenMP runtime into everything fpm builds here; without
# -liomp5 the Python ctypes load fails on __kmpc_* symbols
ENV FPM_LDFLAGS="-liomp5"

# Now compile the fortran code with the band env's ifx and fpm
RUN mamba run -n band fpm test --compiler ifx --flag "-fpp -O3 -qopenmp -DHAVE_MULTI_IMAGE_SUPPORT=0" --profile release \
    && mamba run -n band fpm install --compiler ifx --flag "-fpp -O3 -qopenmp -DHAVE_MULTI_IMAGE_SUPPORT=0" --profile release --prefix .
